+#include <cstdlib>
 #include <cstring>
 #include <limits>
+#include <mutex>
+#include <thread>
 #include <utility>
 
 // Binding recreation must not make a new counter history look like an earlier runtime's history.
@@ -23,6 +30,196 @@ using resident_lease_ptr = std::unique_ptr<ggml_backend_memory_lease,decltype(&g
 using resident_span_plan_ptr = std::unique_ptr<ggml_kv_stream_span_plan,decltype(&ggml_kv_stream_span_plan_free)>;
 struct pending_resident_write;
 
+// Split attention (LLAMA_KV_SPLIT=fraction): in a decode step the CPU attends the oldest streamed pages of each
+// layer in place in the host store, while the GPU attends the rest; the backend merges both parts by their LSE.
+// The pages the CPU takes are not copied. LLAMA_KV_SPLIT_THREADS sets the CPU threads, LLAMA_KV_SPLIT_DEBUG prints timings.
+struct resident_split {
+    struct job {
+        const char * k = nullptr, * v = nullptr;
+        size_t tokens = 0, k_token_bytes = 0, v_token_bytes = 0;
+        ggml_type type_k = GGML_TYPE_COUNT, type_v = GGML_TYPE_COUNT;
+        int64_t dim_k = 0, dim_v = 0, kv_heads = 0, heads = 0;
+        size_t q_nb1 = 0, q_nb2 = 0;
+        float scale = 1.0f;
+        void * fetched = nullptr;
+    };
+
+    float fraction = 0.0f;
+    int threads = 0;
+    bool debug = false, verify = false;
+    float * checked = nullptr;
+    double verify_max = 0.0, verify_sum = 0.0;
+    int64_t verify_count = 0;
+    uint32_t heads = 0;
+    const ggml_kv_stream_split_ops * ops = nullptr;
+    ggml_backend_buffer_t host = nullptr;
+    size_t q_capacity = 0, mask_capacity = 0;
+    float * q = nullptr, * values = nullptr, * lse = nullptr;
+    ggml_fp16_t * mask = nullptr;
+
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::thread worker;
+    ggml_threadpool * pool = nullptr;
+    std::vector<uint8_t> work;
+    job next;
+    bool queued = false, running = false, done = false, ok = false, stop = false;
+
+    int64_t t_wait = 0, t_attend = 0, t_block = 0, n_layers = 0, n_bytes = 0, n_steps = 0;
+
+    ~resident_split() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stop = true;
+        }
+        cv.notify_all();
+        if (worker.joinable()) worker.join();
+        if (host) ggml_backend_buffer_free(host);
+    }
+
+    static std::unique_ptr<resident_split> create(ggml_backend_t backend, const ggml_kv_stream_shape & shape, size_t tokens) {
+        const char * value = std::getenv("LLAMA_KV_SPLIT");
+        if (!value) return {};
+        const float fraction = std::strtof(value,nullptr);
+        // LLAMA_KV_SPLIT_VERIFY: compare every decode layer's output with CPU attention over the whole context.
+        const bool verify = std::getenv("LLAMA_KV_SPLIT_VERIFY") != nullptr;
+        if (!(fraction > 0.0f && fraction < 1.0f) && !(verify && fraction == 0.0f)) {
+            LLAMA_LOG_WARN("%s: LLAMA_KV_SPLIT=%s is not a fraction in (0, 1), split attention off\n", __func__, value);
+            return {};
+        }
+        auto * dev = ggml_backend_get_device(backend);
+        auto get = reinterpret_cast<ggml_kv_stream_split_ops_get>(ggml_backend_reg_get_proc_address(
+            ggml_backend_dev_backend_reg(dev),"ggml_backend_kv_stream_split_ops"));
+        auto * host_type = ggml_backend_dev_host_buffer_type(dev);
+        if (!get || !get() || !host_type || shape.head_dim_k != 256 || shape.head_dim_v != 256) {
+            LLAMA_LOG_WARN("%s: split attention needs the backend's split ops, a host buffer type and head size 256; off\n", __func__);
+            return {};
+        }
+        auto result = std::make_unique<resident_split>();
+        result->fraction = fraction;
+        result->verify = verify;
+        result->ops = get();
+        const char * threads = std::getenv("LLAMA_KV_SPLIT_THREADS");
+        result->threads = threads ? std::atoi(threads) : int(std::max(1u,std::thread::hardware_concurrency()*2/3));
+        if (result->threads < 1) result->threads = 1;
+        result->debug = std::getenv("LLAMA_KV_SPLIT_DEBUG") != nullptr;
+        // one decode row: Q and the output for up to 64 query heads of 256, and a mask row over the context
+        result->q_capacity = 64*256;
+        result->mask_capacity = (tokens+255)/256*256;
+        const size_t bytes = 3*result->q_capacity*sizeof(float) + 64*sizeof(float) + result->mask_capacity*sizeof(ggml_fp16_t) + 5*128;
+        result->host = ggml_backend_buft_alloc_buffer(host_type,bytes);
+        if (!result->host) return {};
+        auto * base = static_cast<char *>(ggml_backend_buffer_get_base(result->host));
+        const auto align = [](size_t n) { return (n+127)/128*128; };
+        size_t offset = 0;
+        result->q = reinterpret_cast<float *>(base+offset); offset += align(result->q_capacity*sizeof(float));
+        result->values = reinterpret_cast<float *>(base+offset); offset += align(result->q_capacity*sizeof(float));
+        result->lse = reinterpret_cast<float *>(base+offset); offset += align(64*sizeof(float));
+        result->checked = reinterpret_cast<float *>(base+offset); offset += align(result->q_capacity*sizeof(float));
+        result->mask = reinterpret_cast<ggml_fp16_t *>(base+offset);
+        LLAMA_LOG_WARN("%s: split attention on: CPU share %.2f of the streamed pages, %d threads\n", __func__, fraction, result->threads);
+        return result;
+    }
+
+    void submit(const job & item) {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            next = item; queued = true; done = false; ok = false;
+        }
+        if (!worker.joinable()) worker = std::thread([this] { main(); });
+        cv.notify_all();
+    }
+
+    // Wait for the submitted layer; true if it succeeded.
+    bool finish() {
+        const int64_t t0 = ggml_time_us();
+        std::unique_lock<std::mutex> lock(mutex);
+        cv.wait(lock,[&] { return done || (!queued && !running); });
+        t_block += ggml_time_us()-t0;
+        const bool result = done && ok;
+        done = false;
+        return result;
+    }
+
+    bool pending() {
+        std::lock_guard<std::mutex> lock(mutex);
+        return queued || running || done;
+    }
+
+    void main() {
+        ggml_threadpool_params params = ggml_threadpool_params_default(threads);
+        pool = ggml_threadpool_new(&params);
+        for (;;) {
+            job item;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                cv.wait(lock,[&] { return stop || queued; });
+                if (stop) break;
+                item = next; queued = false; running = true;
+            }
+            const bool result = pool && attend(item);
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                running = false; done = true; ok = result;
+            }
+            cv.notify_all();
+        }
+        if (pool) ggml_threadpool_free(pool);
+        pool = nullptr;
+    }
+
+    bool attend(const job & item) {
+        const int64_t t0 = ggml_time_us();
+        if (!ops->wait(item.fetched)) return false;
+        const int64_t t1 = ggml_time_us();
+        const ggml_init_params params = {8*ggml_tensor_overhead() + ggml_graph_overhead_custom(8,false), nullptr, true};
+        ggml_context_ptr ctx{ggml_init(params)};
+        if (!ctx) return false;
+        ggml_tensor * q = ggml_new_tensor_3d(ctx.get(),GGML_TYPE_F32,item.dim_k,1,item.heads);
+        q->nb[1] = item.q_nb1; q->nb[2] = item.q_nb2; q->nb[3] = item.q_nb2*size_t(item.heads);
+        q->data = this->q;
+        const auto plane = [&](bool value) {
+            const auto type = value ? item.type_v : item.type_k;
+            const int64_t dim = value ? item.dim_v : item.dim_k;
+            const size_t stride = value ? item.v_token_bytes : item.k_token_bytes;
+            ggml_tensor * t = ggml_new_tensor_3d(ctx.get(),type,dim,int64_t(item.tokens),item.kv_heads);
+            t->nb[1] = stride; t->nb[2] = ggml_row_size(type,dim); t->nb[3] = stride*item.tokens;
+            t->data = const_cast<char *>(value ? item.v : item.k);
+            return t;
+        };
+        ggml_tensor * m = ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F16,int64_t(item.tokens),1);
+        m->data = mask;
+        ggml_tensor * fa = ggml_flash_attn_ext(ctx.get(),q,plane(false),plane(true),m,item.scale,0.0f,0.0f);
+        fa->data = values;
+        ggml_flash_attn_ext_set_lse(fa,lse);
+        ggml_cgraph * graph = ggml_new_graph_custom(ctx.get(),8,false);
+        ggml_build_forward_expand(graph,fa);
+        ggml_cplan plan = ggml_graph_plan(graph,threads,pool);
+        if (plan.work_size > work.size()) work.resize(plan.work_size);
+        plan.work_data = work.data();
+        if (ggml_graph_compute(graph,&plan) != GGML_STATUS_SUCCESS) return false;
+        const int64_t t2 = ggml_time_us();
+        t_wait += t1-t0; t_attend += t2-t1; ++n_layers;
+        n_bytes += int64_t(item.tokens*(item.k_token_bytes+item.v_token_bytes));
+        return true;
+    }
+
+    void report(const std::vector<size_t> & split, size_t padded) {
+        if (!debug || ++n_steps % 32) return;
+        if (verify && verify_count) {
+            LLAMA_LOG_WARN("split verify: output against CPU attention over the whole context: max |diff| %.3g, mean |diff| %.3g\n",
+                verify_max, verify_sum/double(verify_count));
+            verify_max = verify_sum = 0.0; verify_count = 0;
+        }
+        size_t tokens = 0, layers = 0;
+        for (auto item : split) { tokens += item; layers += item != 0; }
+        LLAMA_LOG_WARN("split: context %zu, CPU takes %zu tokens in %zu of %zu layers; per step: CPU waited %.1f ms for Q, "
+            "attended %.1f ms (%.1f GB/s), host blocked %.1f ms\n", padded, tokens, layers, split.size(), t_wait/32e3, t_attend/32e3,
+            t_attend ? n_bytes/(t_attend*1e-6)/1e9 : 0.0, t_block/32e3);
+        t_wait = t_attend = t_block = n_layers = n_bytes = 0;
+    }
+};
+
