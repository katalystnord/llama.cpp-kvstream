 }
+
+// Merge a part attended elsewhere (normalized values, LSE) into the finished vector resume output.
+// The vector splits' (max, sum) stay in the workspace after the combine, so they give the GPU part's LSE.
+__global__ void split_merge_kernel(float * dst, const float2 * meta, int splits, const float * values, const float * lse) {
+    const size_t row = blockIdx.x;
+    const int tid = threadIdx.x;
+    __shared__ float weights[2];
+    if (tid == 0) {
+        const float2 * m = meta + row*splits;
+        float maximum = -INFINITY;
+        for (int i = 0; i < splits; ++i) maximum = fmaxf(maximum, m[i].x);
+        float sum = 0.0f;
+        for (int i = 0; i < splits; ++i) sum += m[i].y > 0.0f ? expf(m[i].x - maximum)*m[i].y : 0.0f;
+        const float own = sum > 0.0f ? maximum + logf(sum) : -INFINITY;
+        const float other = lse[row];
+        const float top = fmaxf(own, other);
+        const float a = own == -INFINITY ? 0.0f : expf(own - top);
+        const float b = other == -INFINITY ? 0.0f : expf(other - top);
+        weights[0] = a/(a + b);
+        weights[1] = b/(a + b);
+    }
+    __syncthreads();
+    dst[row*256 + tid] = weights[0]*dst[row*256 + tid] + weights[1]*values[row*256 + tid];
+}
 } // namespace
 
 // Describe owned workspace without inspecting payloads; stock backend-pool/launch details stay explicitly unknown.
@@ -1385,6 +1409,52 @@ ggml_cuda_kv_stream_plan_status ggml_cuda_kv_stream_attention_plan_query(
     return ggml_cuda_kv_stream_attention_plan_make(metadata, family, style, support, requirements, output);
 }
 
+static bool split_merge(ggml_backend_t backend, ggml_tensor * output, ggml_backend_buffer_t workspace,
+        const ggml_kv_stream_resume_plan & plan, const float * values, const float * lse) {
+    if (!backend || !ggml_backend_is_cuda(backend) || capture_active(backend) || !output || !workspace || !values || !lse ||
+            output->type != GGML_TYPE_F32 || output->ne[0] != 256 || !ggml_is_contiguous(output) ||
+            output->ne[1] != plan.heads || output->ne[2] != plan.queries || output->ne[3] != 1 || plan.splits < 2 ||
+            plan.resume_resident || plan.span_resume) return false;
+    for (auto item : plan.kernel_config) if (item) return false;
+    auto & ctx = *static_cast<ggml_backend_cuda_context *>(backend->context);
+    const auto base = uintptr_t(ggml_backend_buffer_get_base(workspace));
+    if (ggml_backend_buffer_get_type(workspace) != ggml_backend_cuda_device_buffer_type(ctx.device) ||
+            !base || ggml_backend_buffer_get_size(workspace) < plan.bytes) return false;
+    ggml_cuda_set_device(ctx.device);
+    split_merge_kernel<<<unsigned(plan.heads*plan.queries),256,0,ctx.stream()>>>(
+        static_cast<float *>(output->data), reinterpret_cast<const float2 *>(base+plan.meta_offset), int(plan.splits), values, lse);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+
+static bool split_fetch(ggml_backend_t backend, const void * q, void * host_q, size_t q_bytes,
+        const void * mask, void * host_mask, size_t mask_bytes, void ** event) {
+    if (!backend || !ggml_backend_is_cuda(backend) || capture_active(backend) || !q || !host_q || !q_bytes ||
+            (mask_bytes && (!mask || !host_mask)) || !event) return false;
+    auto & ctx = *static_cast<ggml_backend_cuda_context *>(backend->context);
+    ggml_cuda_set_device(ctx.device);
+    cudaEvent_t done;
+    CUDA_CHECK(cudaEventCreateWithFlags(&done,cudaEventDisableTiming));
+    CUDA_CHECK(cudaMemcpyAsync(host_q,q,q_bytes,cudaMemcpyDeviceToHost,ctx.stream()));
+    if (mask_bytes) CUDA_CHECK(cudaMemcpyAsync(host_mask,mask,mask_bytes,cudaMemcpyDeviceToHost,ctx.stream()));
+    CUDA_CHECK(cudaEventRecord(done,ctx.stream()));
+    *event = done;
+    return true;
+}
+
+static bool split_wait(void * event) {
+    if (!event) return false;
+    auto done = static_cast<cudaEvent_t>(event);
+    const bool ok = cudaEventSynchronize(done) == cudaSuccess;
+    CUDA_CHECK(cudaEventDestroy(done));
+    return ok;
+}
+
+const ggml_kv_stream_split_ops * ggml_cuda_kv_stream_split_ops() {
+    static const ggml_kv_stream_split_ops ops{split_fetch,split_wait,split_merge};
+    return &ops;
+}
