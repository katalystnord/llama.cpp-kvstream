diff --git a/ggml/src/ggml-kv-stream-split.h b/ggml/src/ggml-kv-stream-split.h
new file mode 100644
index 000000000..bb46e797f
--- /dev/null
+++ b/ggml/src/ggml-kv-stream-split.h
@@ -0,0 +1,19 @@
+#pragma once
+
+#include "ggml-kv-stream-device.h"
+
+// Split attention: a part of the K/V is attended elsewhere (the CPU, in place in host memory) and merged by its
+// log-sum-exp. Backend proc "ggml_backend_kv_stream_split_ops". Host pointers are in the device's host buffer type.
+struct ggml_kv_stream_split_ops {
+    // Queue copies of q_bytes from q and mask_bytes from mask (device pointers) to host memory behind the work already
+    // queued on the backend, and record their completion in a new event.
+    bool (*fetch)(ggml_backend_t backend, const void * q, void * host_q, size_t q_bytes,
+            const void * mask, void * host_mask, size_t mask_bytes, void ** event);
+    // Block until the fetch is done; frees the event.
+    bool (*wait)(void * event);
+    // After the last resume span of a vector plan (splits > 1): merge values [queries][heads][256] (normalized) and
+    // lse [queries][heads], both complete in host memory, into the output. Asynchronous.
+    bool (*merge)(ggml_backend_t backend, ggml_tensor * output, ggml_backend_buffer_t workspace,
+            const ggml_kv_stream_resume_plan & plan, const float * values, const float * lse);
+};
+using ggml_kv_stream_split_ops_get = const ggml_kv_stream_split_ops * (*)();
