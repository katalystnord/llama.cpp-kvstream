index 780030c3e..c81f0b221 100644
--- a/src/llama-kv-stream-resident.cpp
+++ b/src/llama-kv-stream-resident.cpp
@@ -9,12 +9,19 @@
 #include "../ggml/src/ggml-cuda-graph.h"
 #include "../ggml/src/ggml-backend-execution.h"
 #include "llama-impl.h"
