+#!/bin/bash
+# Build for brick (sm_75). Configured with -DGGML_CUDA_KV_STREAM_D512=OFF (local patch): the six head-512
+# kv-stream-mma-runtime units need more than 24 GB of RAM each in cicc and are only used by Gemma 4.
+set -e
+B=${KV_STREAM_BRICK:-$HOME/code/kv-stream-brick}/llama.cpp-adaptive-kv-streaming/build-sm75
+echo "== $(date +%T) build, 3 jobs"
+cmake --build "$B" --target llama-server llama-bench test-cuda-compiled-features test-kv-stream-model --parallel 3
+echo "== $(date +%T) BUILD OK"
diff --git a/scripts/kv-stream-brick/fa-cpu.cpp b/scripts/kv-stream-brick/fa-cpu.cpp
new file mode 100644
index 000000000..2675202c8
--- /dev/null
+++ b/scripts/kv-stream-brick/fa-cpu.cpp
@@ -0,0 +1,60 @@
+// Time ggml CPU flash attention in the split's shape: one query row, 16 heads over 4 KV heads of 256,
+// q8_0 K and q4_0 V in token-major rows (the host store layout), with a zero mask and the LSE output.
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "ggml-fa-lse.h"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+int main(int argc, char ** argv) {
+    const int64_t tokens = argc > 1 ? atoll(argv[1]) : 512;
+    const int threads = argc > 2 ? atoi(argv[2]) : 4;
+    const int reps = argc > 3 ? atoi(argv[3]) : 20;
+    const int64_t D = 256, H = 16, KVH = 4;
+    const size_t krow = ggml_row_size(GGML_TYPE_Q8_0, D), vrow = ggml_row_size(GGML_TYPE_Q4_0, D);
+    std::vector<uint8_t> K(tokens*KVH*krow), V(tokens*KVH*vrow);
+    for (auto & b : K) b = rand(); for (auto & b : V) b = rand();
+    // keep the q8_0/q4_0 scales finite: set every block's f16 scale to 0.01
+    const ggml_fp16_t sc = ggml_fp32_to_fp16(0.01f);
+    for (size_t i = 0; i < K.size(); i += 34) memcpy(&K[i], &sc, 2);
+    for (size_t i = 0; i < V.size(); i += 18) memcpy(&V[i], &sc, 2);
+    std::vector<float> Q(H*D), out(H*D), lse(H);
+    for (auto & x : Q) x = (rand()/(float)RAND_MAX - 0.5f);
+    std::vector<ggml_fp16_t> M(tokens, ggml_fp32_to_fp16(0.0f));
+    ggml_threadpool_params tpp = ggml_threadpool_params_default(threads);
+    ggml_threadpool * pool = ggml_threadpool_new(&tpp);
+    std::vector<uint8_t> work;
+    double best = 1e9, total = 0;
+    for (int r = 0; r < reps; ++r) {
+        auto t0 = std::chrono::steady_clock::now();
+        ggml_init_params ip = {16*ggml_tensor_overhead() + ggml_graph_overhead_custom(8,false), nullptr, true};
+        ggml_context * ctx = ggml_init(ip);
+        ggml_tensor * q = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, 1, H); q->data = Q.data();
+        ggml_tensor * k = ggml_new_tensor_3d(ctx, GGML_TYPE_Q8_0, D, tokens, KVH);
+        k->nb[1] = KVH*krow; k->nb[2] = krow; k->nb[3] = KVH*krow*tokens; k->data = K.data();
+        ggml_tensor * v = ggml_new_tensor_3d(ctx, GGML_TYPE_Q4_0, D, tokens, KVH);
+        v->nb[1] = KVH*vrow; v->nb[2] = vrow; v->nb[3] = KVH*vrow*tokens; v->data = V.data();
+        ggml_tensor * m = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, tokens, 1); m->data = M.data();
+        ggml_tensor * fa = ggml_flash_attn_ext(ctx, q, k, v, m, 0.0625f, 0, 0);
+        fa->data = out.data();
+        ggml_flash_attn_ext_set_lse(fa, lse.data());
+        ggml_cgraph * g = ggml_new_graph_custom(ctx, 8, false);
+        ggml_build_forward_expand(g, fa);
+        ggml_cplan plan = ggml_graph_plan(g, threads, pool);
+        if (plan.work_size > work.size()) work.resize(plan.work_size);
+        plan.work_data = work.data();
+        auto t1 = std::chrono::steady_clock::now();
+        ggml_graph_compute(g, &plan);
+        auto t2 = std::chrono::steady_clock::now();
+        ggml_free(ctx);
+        const double ms = std::chrono::duration<double, std::milli>(t2-t0).count();
+        if (r == 0) printf("first call %.3f ms (setup %.3f ms), work %zu bytes\n", ms, std::chrono::duration<double, std::milli>(t1-t0).count(), plan.work_size);
+        else { best = std::min(best, ms); total += ms; }
+    }
+    const double bytes = double(tokens)*KVH*(krow+vrow);
+    printf("tokens %lld threads %d: best %.3f ms, mean %.3f ms, %.2f GB/s (best), lse[0] %g out[0] %g\n", (long long)tokens, threads,
+        best, total/(reps-1), bytes/(best*1e-3)/1e9, lse[0], out[0]);
+    ggml_threadpool_free(pool);
+}
diff --git a/scripts/kv-stream-brick/longctx.py b/scripts/kv-stream-brick/longctx.py
new file mode 100644
index 000000000..8027378ee
--- /dev/null
+++ b/scripts/kv-stream-brick/longctx.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Long-context runs against a running llama-server: exact-length token prompts, greedy, one JSON line per run.
+
+usage: [CACHE=1] [N_PREDICT=64] longctx.py PORT LABEL OUT.jsonl N [N ...]
+CACHE=1 reuses the server's cached prompt (after a slot restore only the tail is computed).
+Corpus: all .md files of the fork (sorted), tokenized once by the server and cached in runs/corpus-tokens.json.
+"""
+import json, os, subprocess, sys, time, urllib.request
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.join(HERE, "llama.cpp-adaptive-kv-streaming")
+CACHE = os.path.join(HERE, "runs", "corpus-tokens.json")
+TAIL = "\n\nQuestion: in one sentence, what is the text above about?\nAnswer:"
+
+
+def post(port, path, body, timeout=7200):
+    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        return json.load(r)
+
+
+def corpus_tokens(port):
+    if os.path.exists(CACHE):
+        return json.load(open(CACHE))
+    files = sorted(os.path.join(d, f) for d, _, fs in os.walk(REPO) if "/build" not in d and "/.git" not in d
+                   for f in fs if f.endswith(".md"))
+    text = "\n\n".join(open(f, errors="replace").read() for f in files)
+    toks = post(port, "/tokenize", {"content": text})["tokens"]
+    json.dump(toks, open(CACHE, "w"))
+    return toks
+
+
+def gpu():
+    q = "memory.used,clocks.sm,power.draw,pcie.link.gen.current,temperature.gpu"
+    return subprocess.run(["nvidia-smi", f"--query-gpu={q}", "--format=csv,noheader"],
+                          capture_output=True, text=True).stdout.strip()
+
+
+def main():
+    port, label, out = sys.argv[1], sys.argv[2], sys.argv[3]
+    lengths = [int(n) for n in sys.argv[4:]]
+    toks = corpus_tokens(port)
+    tail = post(port, "/tokenize", {"content": TAIL})["tokens"]
+    for n in lengths:
+        prompt = toks[: n - len(tail)] + tail
+        t0 = time.time()
+        rec = {"label": label, "prompt_tokens_requested": n, "start": time.strftime("%H:%M:%S")}
+        try:
+            d = post(port, "/completion", {"prompt": prompt, "n_predict": int(os.environ.get("N_PREDICT", 64)),
+                                           "temperature": 0, "cache_prompt": bool(os.environ.get("CACHE"))})
+            t = d["timings"]
+            rec.update(prompt_n=t["prompt_n"], prefill_tps=round(t["prompt_per_second"], 2),
+                       gen_n=t["predicted_n"], decode_tps=round(t["predicted_per_second"], 2),
+                       text=d["content"])
+        except Exception as e:
+            rec["error"] = repr(e)
+        rec["wall_s"] = round(time.time() - t0, 1)
+        rec["gpu_after"] = gpu()
+        print(json.dumps(rec), flush=True)
+        with open(out, "a") as f:
+            f.write(json.dumps(rec) + "\n")
+        if "error" in rec:
+            break
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/kv-stream-brick/measure.sh b/scripts/kv-stream-brick/measure.sh
new file mode 100755
index 000000000..d7dbcf363
--- /dev/null
+++ b/scripts/kv-stream-brick/measure.sh
@@ -0,0 +1,73 @@
+#!/bin/bash
+# The release measurement set (MEASURE-LIKE-BEAST.md) on brick: Qwen3.5 4B Q4_K_M, q8_0 K and V, greedy, no drafting
+# (no MTP head), batch and ubatch 256 everywhere. Probe: probe/longctx.py (beast's, prompt text from the fork at
+# bcf1a81d6 in probe/src-bcf1a81d6). Each run logs the server, the probe JSON, the answers, and a sample every 2 s of
+# GPU memory, power, SM clock, temperature, throttle reasons and the server's RSS.
+# usage: measure.sh RUN...   RUN: plain spill1 spill2 stream split stream250
+H=${KV_STREAM_BRICK:-$HOME/code/kv-stream-brick}
+O=$H/results/gtx1650-i7-9750h; mkdir -p $O/answers $H/slots
+BIN=$H/llama.cpp-adaptive-kv-streaming/build-sm75/bin/llama-server
+COMMON=(-m $H/models/Qwen3.5-4B-Q4_K_M.gguf --parallel 1 --n-gpu-layers 999 --flash-attn on --fit off
+        --cache-type-k q8_0 --cache-type-v q8_0 --no-mmproj --spec-type none -b 256 -ub 256 --port 8099)
+STREAM=(--shared-device-memory-mib 896)
+export PROBE_SRC=$H/probe/src-bcf1a81d6 ANSWER_DIR=$O/answers
+say() { echo "[$(date +%F\ %T)] $*"; }
+post() { curl -s -m 1200 -H 'Content-Type: application/json' -d "$2" "http://127.0.0.1:8099$1"; }
+
+start() {  # name ctx [args...]: env for the server comes from the caller
+  NAME=$1; local ctx=$2; shift 2
+  "$BIN" "${COMMON[@]}" --ctx-size $ctx --slot-save-path $H/slots "$@" > $O/server-$NAME.log 2>&1 &
+  PID=$!
+  ( echo "time,gpu_mem_mib,power_w,sm_mhz,temp_c,throttle,server_rss_mib,ram_used_mib"
+    while kill -0 $PID 2>/dev/null; do
+      g=$(nvidia-smi --query-gpu=memory.used,power.draw,clocks.sm,temperature.gpu,clocks_throttle_reasons.active \
+          --format=csv,noheader,nounits | tr -d ' ')
+      r=$(( $(ps -o rss= -p $PID 2>/dev/null || echo 0) / 1024 ))
+      echo "$(date +%T),$g,$r,$(free -m | awk '/^Mem:/{print $3}')"; sleep 2
+    done ) > $O/samples-$NAME.csv &
+  for i in $(seq 300); do
+    curl -s -m2 localhost:8099/health | grep -q ok && { say "$NAME up: $(tail -1 $O/samples-$NAME.csv)"; return 0; }
+    kill -0 $PID 2>/dev/null || break; sleep 2
+  done
+  say "$NAME: server did not start"; grep -E ' E ' $O/server-$NAME.log | tail -3; kill $PID 2>/dev/null; wait $PID 2>/dev/null; return 1
+}
+stop() { kill $PID; wait $PID 2>/dev/null; sleep 3; }
+probe() {  # depth label [timeout_s]
+  timeout ${3:-14400} python3 -I -u $H/probe/longctx.py 8099 $1 $2 >> $O/$NAME.jsonl || say "$2: no answer (timeout ${3:-14400} s or error)"
+  tail -1 $O/$NAME.jsonl | sed -E 's/, "answer_start".*/}/'
+}
+
+for RUN in "$@"; do case $RUN in
+plain)   # stock attention, whole cache on the GPU, the largest window that loads with q8_0 V
+  for ctx in 49152 45056 40960; do start plain $ctx && break; done || continue
+  for d in 8000 32000 $((ctx-1000)); do probe $d plain@$d; done; stop ;;
+spill1)  # cache in RAM, attention on the CPU
+  start spill1 131072 --no-kv-offload || continue
+  for d in 32000 64000 125000; do probe $d nkvo@$d 7200; done; stop ;;
+spill2)  # no stream, the driver pages GPU memory to RAM; 30 minutes per request
+  export GGML_CUDA_ENABLE_UNIFIED_MEMORY=1; start spill2 131072; ok=$?; unset GGML_CUDA_ENABLE_UNIFIED_MEMORY
+  [ $ok = 0 ] || continue
+  for d in 64000 125000; do probe $d unified@$d 1800; done; stop ;;
+stream)  # the fork's streaming; saves the 64K and 125K slots for the split runs
+  start stream 131072 "${STREAM[@]}" || continue
+  for d in 8000 32000 64000 125000; do
+    probe $d stream@$d
+    case $d in 64000|125000) say "saved: $(post '/slots/0?action=save' "{\"filename\": \"probe-$d.bin\"}" | cut -c1-120)";; esac
+  done; stop ;;
+split)   # no split (the stream run), auto, and the ceiling (CPU part skipped, output wrong); slot restored, prompt reused
+  for mode in auto noop; do for d in 64000 125000; do
+    [ -s $H/slots/probe-$d.bin ] || { say "no slot for $d: run stream first"; continue; }
+    unset LLAMA_KV_SPLIT_NOOP
+    if [ $mode = noop ]; then export LLAMA_KV_SPLIT=0.5 LLAMA_KV_SPLIT_NOOP=1; else export LLAMA_KV_SPLIT=auto; fi
+    export LLAMA_KV_SPLIT_THREADS=6 LLAMA_KV_SPLIT_DEBUG=1
+    start split-$mode-$d 131072 "${STREAM[@]}"; ok=$?
+    unset LLAMA_KV_SPLIT LLAMA_KV_SPLIT_NOOP LLAMA_KV_SPLIT_THREADS LLAMA_KV_SPLIT_DEBUG
+    [ $ok = 0 ] || continue
+    say "restored: $(post '/slots/0?action=restore' "{\"filename\": \"probe-$d.bin\"}" | cut -c1-120)"
+    probe $d split-$mode@$d; stop
+  done; done ;;
+stream250)  # the deepest: 250K in a 262,144 window
+  start stream250 262144 "${STREAM[@]}" || continue
+  probe 250000 stream@250000; stop ;;
+esac; done
+say "MEASURE DONE: $*"
diff --git a/scripts/kv-stream-brick/probe-longctx.py b/scripts/kv-stream-brick/probe-longctx.py
new file mode 100644
index 000000000..7d1b4053e
--- /dev/null
+++ b/scripts/kv-stream-brick/probe-longctx.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Long-context probe for the kv-stream fork (2026-10-28). Builds a prompt of about N tokens from llama.cpp's own source
+files (public text), hides a code word at 10% depth, asks for it at the end plus a short task, and prints the server's
+prefill and decode speed and whether the code word came back. Usage: longctx.py <port> <target_tokens> [label]"""
+import glob, json, os, sys, time, urllib.request
+
+PORT, TARGET = int(sys.argv[1]), int(sys.argv[2])
+LABEL = sys.argv[3] if len(sys.argv) > 3 else ''
+URL = 'http://127.0.0.1:%d' % PORT
+NEEDLE = 'Note for the reader: the code word for the beast test is MARMALADE-7.'
+QUESTION = ('\n\nQuestion 1: what is the code word for the beast test, exactly as written above? '
+            'Question 2: in about 150 words, what does the file llama-context.cpp above do? Answer both briefly.')
+
+
+def post(path, body, timeout=3600):
+    req = urllib.request.Request(URL + path, json.dumps(body).encode(), {'Content-Type': 'application/json'})
+    return json.load(urllib.request.urlopen(req, timeout=timeout))
+
+
+def ntok(text):
+    return len(post('/tokenize', {'content': text})['tokens'])
+
+
+src = os.environ.get('PROBE_SRC') or os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))  # repo root
+files = sorted(glob.glob(src + '/src/*.cpp') + glob.glob(src + '/common/*.cpp') + glob.glob(src + '/tools/server/*.cpp'))
+first = [f for f in files if f.endswith('src/llama-context.cpp')]
+files = first + [f for f in files if f not in first]
+parts, total = [], 0
+for f in files:
+    text = '\n// ===== file %s =====\n' % os.path.relpath(f, src) + open(f, errors='replace').read()
+    parts.append(text)
+    total += len(text)
+    if total > TARGET * 4.2:  # code is about 3 to 4 characters per token; trimmed exactly below
+        break
+body = ''.join(parts)
+toks = post('/tokenize', {'content': body})['tokens']
+if len(toks) > TARGET:
+    body = post('/detokenize', {'tokens': toks[:TARGET]})['content']
+cut = len(body) // 10
+body = body[:cut] + '\n\n' + NEEDLE + '\n\n' + body[cut:]
+prompt_tokens = ntok(body + QUESTION)
+
+t = time.time()
+d = post('/v1/chat/completions', {'model': 'x', 'temperature': 0, 'max_tokens': 400,
+                                  'chat_template_kwargs': {'enable_thinking': False},
+                                  'messages': [{'role': 'user', 'content': body + QUESTION}]})
+wall = time.time() - t
+ans = d['choices'][0]['message'].get('content') or ''
+tm = d.get('timings', {})
+if os.environ.get('ANSWER_DIR'):  # the whole answer, to compare runs word for word
+    with open(os.path.join(os.environ['ANSWER_DIR'], (LABEL or 'answer') + '.txt'), 'w') as f:
+        f.write(ans)
+print(json.dumps({'label': LABEL, 'prompt_tokens': prompt_tokens, 'wall_s': round(wall, 1),
+                  'prefill_tps': round(tm.get('prompt_per_second', 0), 1), 'decode_tps': round(tm.get('predicted_per_second', 0), 1),
+                  'draft': '%s/%s' % (tm.get('draft_n_accepted'), tm.get('draft_n')),
+                  'needle_found': 'MARMALADE-7' in ans, 'answer_start': ans[:300]}, ensure_ascii=False))
diff --git a/scripts/kv-stream-brick/split-smoke.sh b/scripts/kv-stream-brick/split-smoke.sh
