@@ -0,0 +1,14 @@
+#!/bin/bash
+# Split attention smoke test: same prompt with and without LLAMA_KV_SPLIT, greedy; compare answers.
+# usage: [LLAMA_KV_SPLIT_VERIFY=1] split-smoke.sh CTX ARENA_MIB PROMPT_TOKENS LABEL [FRAC|off] [THREADS]
+H=${KV_STREAM_BRICK:-$HOME/code/kv-stream-brick}
+CTX=$1 ARENA=$2 N=$3 LABEL=$4 FRAC=${5:-off} THREADS=${6:-8}
+if [ "$FRAC" != off ]; then export LLAMA_KV_SPLIT=$FRAC LLAMA_KV_SPLIT_THREADS=$THREADS LLAMA_KV_SPLIT_DEBUG=1; fi
+$H/llama.cpp-adaptive-kv-streaming/build-sm75/bin/llama-server -m $H/models/Qwen3.5-4B-Q4_K_M.gguf \
+  --ctx-size $CTX --parallel 1 --n-gpu-layers 999 --flash-attn on --fit off --cache-type-k q8_0 --cache-type-v q4_0 \
+  --no-mmproj -b 256 -ub 256 --shared-device-memory-mib $ARENA --port 8098 > $H/runs/split-$LABEL.log 2>&1 &
+PID=$!
+for i in $(seq 120); do curl -s -m2 localhost:8098/health | grep -q ok && break; kill -0 $PID 2>/dev/null || { echo "server died"; tail -5 $H/runs/split-$LABEL.log; exit 1; }; sleep 2; done
+python3 -I -u $H/longctx.py 8098 $LABEL $H/runs/split.jsonl $N
+kill $PID; wait $PID 2>/dev/null
+grep -E 'split attention|split:|split verify' $H/runs/split-$LABEL.log | tail -4
diff --git a/scripts/kv-stream-brick/split-sweep.sh b/scripts/kv-stream-brick/split-sweep.sh
new file mode 100755
index 000000000..f6e524546
--- /dev/null
+++ b/scripts/kv-stream-brick/split-sweep.sh
@@ -0,0 +1,40 @@
+#!/bin/bash
+# Split attention sweep: the prompt at DEPTH is read once and the slot saved; each setting restarts the server,
+# restores the slot and writes N_PREDICT tokens greedily (only the tail is recomputed).
+# Settings "fraction:threads": "none:0" = split code off (stock write-combined host store),
+# "0:0" = split off with the cached host store (control), "0.3:6" = CPU share 0.3 with 6 threads.
+# usage: split-sweep.sh CTX ARENA_MIB DEPTH "SETTINGS..." [TAG]     results: runs/split.jsonl, logs runs/sweep-*.log
+H=${KV_STREAM_BRICK:-$HOME/code/kv-stream-brick}
+CTX=$1 ARENA=$2 DEPTH=$3 SETTINGS=$4 TAG=${5:-sweep}
+SLOTS=$H/slots; mkdir -p $SLOTS; FILE=fill-$CTX-$ARENA-$DEPTH.bin
+say() { echo "[$(date +%T)] $*"; }
+start() {  # label fraction threads [extra args]
+  local label=$1 frac=$2 threads=$3; shift 3
+  unset LLAMA_KV_SPLIT LLAMA_KV_SPLIT_THREADS LLAMA_KV_SPLIT_DEBUG
+  if [ "$frac" != none ]; then export LLAMA_KV_SPLIT=$frac LLAMA_KV_SPLIT_THREADS=$threads LLAMA_KV_SPLIT_DEBUG=1; fi
+  $H/llama.cpp-adaptive-kv-streaming/build-sm75/bin/llama-server -m $H/models/Qwen3.5-4B-Q4_K_M.gguf \
+    --ctx-size $CTX --parallel 1 --n-gpu-layers 999 --flash-attn on --fit off --cache-type-k q8_0 --cache-type-v q4_0 \
+    --no-mmproj -b 256 -ub 256 --shared-device-memory-mib $ARENA --port 8098 --slot-save-path $SLOTS "$@" \
+    > $H/runs/$TAG-$label.log 2>&1 &
+  PID=$!
+  for i in $(seq 150); do curl -s -m2 localhost:8098/health | grep -q ok && return 0; kill -0 $PID 2>/dev/null || break; sleep 2; done
+  say "$label: server did not start"; tail -3 $H/runs/$TAG-$label.log; return 1
+}
+stop() { kill $PID; wait $PID 2>/dev/null; sleep 2; }
+post() { curl -s -m 1200 -H 'Content-Type: application/json' -d "$2" "http://127.0.0.1:8098$1"; }
+
+if [ ! -s $SLOTS/$FILE ]; then
+  start fill none 0 || exit 1
+  CACHE=1 N_PREDICT=64 python3 -I -u $H/longctx.py 8098 $TAG-fill-$DEPTH $H/runs/split.jsonl $DEPTH | cut -c1-220
+  say "saved: $(post '/slots/0?action=save' "{\"filename\": \"$FILE\"}" | cut -c1-200)"
+  stop
+fi
+for c in $SETTINGS; do
+  f=${c%%:*}; t=${c##*:}; label=f$f-t$t-$DEPTH
+  start $label $f $t || continue
+  say "$label: restored: $(post '/slots/0?action=restore' "{\"filename\": \"$FILE\"}" | cut -c1-160)"
+  CACHE=1 N_PREDICT=${N_PREDICT:-64} python3 -I -u $H/longctx.py 8098 $TAG-$label $H/runs/split.jsonl $DEPTH | cut -c1-260
+  grep -E 'split verify|W split:' $H/runs/$TAG-$label.log | tail -2 | cut -c1-260
+  stop
+done
+say "SWEEP DONE"
