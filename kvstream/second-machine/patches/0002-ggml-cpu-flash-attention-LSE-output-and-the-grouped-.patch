 ggml/src/ggml-cpu/ggml-cpu.c |  21 +-
 ggml/src/ggml-cpu/ops.cpp    | 406 +++++++++++++++++++++++++++++++++++
 ggml/src/ggml-fa-lse.h       |  13 ++
 4 files changed, 440 insertions(+), 1 deletion(-)
 create mode 100644 ggml/src/ggml-fa-lse.h

