--- a/ggml/src/ggml-cpu/common.h
+++ b/ggml/src/ggml-cpu/common.h
@@ -8,6 +8,7 @@
 
 #define GGML_FA_TILE_Q  64
 #define GGML_FA_TILE_KV 64
+#define GGML_FA_GQA_BLOCK 16 // K/V rows per block of the grouped-query decode path (ops.cpp)
 
 #ifdef __cplusplus
 
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 7c274c03b..f2eb8e88d 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -2999,7 +2999,26 @@ struct ggml_cplan ggml_graph_plan(
                         size_t n_chunks = n_tasks;
                         size_t decode   = sizeof(float)*(neq2*n_chunks*(2+DV) + n_tasks*(DK + 2*DV));
 
-                        cur += MAX(prefill, decode);
+                        // Grouped-query decode (ggml_compute_forward_flash_attn_ext_gqa): partials per (query row, query
+                        // head, chunk), at most 2*n_tasks chunks; per thread the f32 accumulators, M and S of a group's
+                        // query vectors, a V row and the query vectors converted for the K dot product
+                        // (a work item takes several KV heads when they lie side by side in a row: the most that
+                        // divide them with at most GGML_FA_GQA_MAX_NQ (64) query vectors, as in ops.cpp)
+                        // (and per KV head of the item a block of GGML_FA_GQA_BLOCK V rows in f32)
+                        const int64_t N    = node->src[0]->ne[1];
+                        const int64_t nek2 = MAX(node->src[1]->ne[2], 1);
+                        int64_t NQ = N*(neq2/nek2);
+                        int64_t G  = 1;
+                        for (int64_t g = nek2; g > 1; --g) {
+                            if (nek2 % g == 0 && NQ*g <= 64) {
+                                G = g;
+                                break;
+                            }
+                        }
+                        NQ *= G;
+                        size_t gqa = sizeof(float)*(N*neq2*2*n_tasks*(2+DV) + n_tasks*(NQ*(DV + 2 + DK) + G*GGML_FA_GQA_BLOCK*DV + CACHE_LINE_SIZE/sizeof(float)));
+
+                        cur += MAX(MAX(prefill, decode), gqa);
                     } break;
                 case GGML_OP_FLASH_ATTN_BACK:
                     {
