+#pragma once
+
+#include "ggml.h"
+
+#include <string.h>
+
+// GGML_OP_FLASH_ATTN_EXT op_params 6-7: optional per-row log-sum-exp output (host pointer, CPU kernels only).
+// lse[token*n_head + head] = log(sum(exp(scale*q.k + mask))), so that results over disjoint K/V merge exactly.
+#define GGML_FA_PARAM_LSE 6
+
+static inline void ggml_flash_attn_ext_set_lse(struct ggml_tensor * a, float * lse) {
+    memcpy(a->op_params + GGML_FA_PARAM_LSE, &lse, sizeof(lse));
