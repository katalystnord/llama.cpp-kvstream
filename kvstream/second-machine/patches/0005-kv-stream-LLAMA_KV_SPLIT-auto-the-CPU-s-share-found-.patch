+    // LLAMA_KV_SPLIT=auto: hill climbing on the time per decode step, in windows of 16 steps
+    struct tuner_state {
+        bool on = false;
+        int phase = 0;           // 0: measure the base share, 1: measure a probe, 2: settled
+        float base = 0.0f, probe = 0.0f, dir = 1.0f;
+        bool turned = false;     // the other direction was tried
+        bool ahead = false;      // a probe two steps away was tried after one step did not pay
+        double t_base = 0.0;     // us per step at the base share
+        int skip = 2;            // steps not counted after a change
+        uint32_t settled = 0;    // steps since settling
+        size_t streamed = 0;     // streamed tokens when settled
+        std::vector<int64_t> samples;
+        int64_t t_last = 0;      // start of the previous decode step, 0 after a step that was not one
+    };
+    // The binding (and this object) is rebuilt at every KV layout change, so the tuner lives outside it.
+    static tuner_state & shared_tuner() {
+        static tuner_state state;
+        return state;
+    }
+    tuner_state & tuner = shared_tuner();
