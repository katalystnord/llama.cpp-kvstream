+    // LLAMA_KV_SPLIT=auto (beast's tuner): the share for the coming decode step. The time since the previous decode step
+    // started counts for the share that step used. A window's time is its mean over 16 steps after two skipped, without
+    // steps slower than three times the median. From share 0, a step of 0.1 is kept when at least 2% faster; it settles,
+    // then looks again after 512 steps or when the streamed tokens change by a quarter. Nothing streams: no split.
+    float share(size_t streamed) {
+        auto & t = tuner;
+        const int64_t now = ggml_time_us();
+        const bool counted = t.t_last && streamed;
+        if (counted) {
+            if (t.skip > 0) --t.skip;
+            else t.samples.push_back(now-t.t_last);
+        }
+        t.t_last = now;
+        if (!streamed) return 0.0f;
+        const float current = t.phase == 1 ? t.probe : t.base;
+        if (t.phase == 2) {
+            if ((counted && ++t.settled >= 512) || streamed > t.streamed+t.streamed/4 || streamed+streamed/4 < t.streamed) {
+                if (debug) LLAMA_LOG_WARN("split auto: again after %u steps, %zu streamed tokens (settled with %zu)\n",
+                    t.settled, streamed, t.streamed);
+                t.phase = 0; t.samples.clear(); t.skip = 2; t.turned = false; t.ahead = false;
+            }
+            return t.base;
+        }
+        constexpr size_t window = 16;
+        constexpr float step = 0.1f;
+        if (t.samples.size() < window) return current;
+        std::vector<int64_t> sorted = t.samples;
+        std::nth_element(sorted.begin(),sorted.begin()+window/2,sorted.end());
+        const int64_t median = sorted[window/2];
+        int64_t sum = 0, n = 0;
+        for (auto item : t.samples) if (item <= 3*median) { sum += item; ++n; }
+        const double mean = double(sum)/double(std::max<int64_t>(n,1));
+        t.samples.clear(); t.skip = 2;
+        if (debug) LLAMA_LOG_WARN("split auto: share %.2f: %.1f ms per token\n", current, mean/1e3);
+        const auto settle = [&] {
+            t.phase = 2; t.settled = 0; t.streamed = streamed;
+            if (debug) LLAMA_LOG_WARN("split auto: settled at %.2f (%.1f ms per token, %zu streamed tokens)\n", t.base, t.t_base/1e3, streamed);
+            return t.base;
+        };
+        const auto try_probe = [&] {
+            const float p = std::clamp(t.base+t.dir*step,0.0f,0.9f);
+            if (std::fabs(p-t.base) < 1e-3f) return false;
+            t.probe = p; t.phase = 1;
+            return true;
+        };
+        if (t.phase == 0) {
+            t.t_base = mean;
+            if (try_probe()) return t.probe;
+            t.dir = -t.dir;
+            return try_probe() ? t.probe : settle();
+        }
+        // a probe: keep it if at least 2% faster and go on in the same direction
+        if (mean < 0.98*t.t_base) {
+            t.base = t.probe; t.t_base = mean; t.turned = true; t.ahead = false;
+            return try_probe() ? t.probe : settle();
+        }
+        // from no split, one step may not cover the split's fixed cost: try two steps once before giving up
+        if (!t.ahead && t.base == 0.0f && std::fabs(t.probe-t.base) < 1.5f*step) {
+            t.ahead = true;
+            const float p = std::clamp(t.base+2.0f*t.dir*step,0.0f,0.9f);
+            if (std::fabs(p-t.probe) > 1e-3f) {
+                t.probe = p;
+                return t.probe;
+            }
+        }
+        if (!t.turned) {
+            t.turned = true; t.ahead = false; t.dir = -t.dir;
+            if (try_probe()) return t.probe;
+        }
+        return settle();
+    }
+
     void report(const std::vector<size_t> & split, size_t padded) {
         if (!debug || ++n_steps % 32) return;
         if (verify && verify_count) {
@@ -708,7 +813,10 @@ bool llama_kv_stream_resident::begin_sequence(const std::vector<uint32_t> & laye
             seq->profile |= !feedback_context.read_only && feedback_context.decode && seq->queries == 1 && prefixes.back() < immutable;
         }
         seq->split_tokens.assign(layers.size(),0);
-        if (s.split && s.split->heads && seq->decode && seq->queries == 1 && !seq->read_only && s.resumed_decode && !s.fallback) {
+        const bool split_step = s.split && s.split->heads && seq->decode && seq->queries == 1 && !seq->read_only &&
+            s.resumed_decode && !s.fallback;
+        if (s.split && !split_step) s.split->tuner.t_last = 0;
+        if (split_step) {
             ggml_kv_stream_resume_plan plan;
             const auto * ops = partial_ops();
             const bool vector = ggml_kv_stream_resume_plan_query(ops,s.backend,{s.binding.config.shape,s.split->heads,1,seq->padded},plan) &&
@@ -716,11 +824,19 @@ bool llama_kv_stream_resident::begin_sequence(const std::vector<uint32_t> & laye
                 std::all_of(std::begin(plan.kernel_config),std::end(plan.kernel_config),[](uint32_t item) { return item == 0; });
             // The CPU takes the oldest streamed pages, never rows written in this step, and leaves the GPU at least one page.
             const size_t page = s.page.tokens, immutable = stable/page*page;
+            float fraction = s.split->fraction;
+            if (s.split->tuner.on) {
+                size_t streamed = 0;
+                for (size_t i = 0; vector && i < layers.size(); ++i) {
+                    if (prefixes[i] && prefixes[i] < seq->padded && immutable > prefixes[i]) streamed += seq->padded-prefixes[i];
+                }
+                fraction = s.split->share(streamed);
+            }
             for (size_t i = 0; vector && i < layers.size(); ++i) {
                 const size_t prefix = prefixes[i];
                 if (!prefix || prefix >= seq->padded || immutable <= prefix) continue;
                 const size_t streamed = seq->padded-prefix;
-                size_t tokens = size_t(double(s.split->fraction)*double(streamed))/page*page;
+                size_t tokens = size_t(double(fraction)*double(streamed))/page*page;
                 tokens = std::min({tokens,immutable-prefix,streamed-page,s.split->mask_capacity});
                 seq->split_tokens[i] = tokens;
                 prefixes[i] += tokens;
